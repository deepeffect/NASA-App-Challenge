# Kopyala: cp .env.example .env   (PowerShell: Copy-Item .env.example .env)
# Göreli yollar repo köküne göre çözülür.

APP_ENV=dev

# --- İstasyon (README → "3 bilgisayar kurulumu") ---
# ship: gemi bilgisayarı (bütün veri, astronot ekranı /me) | earth: Dünya üssü (salt okunur, /monitor)
STATION_ROLE=ship
# Sadece earth: gemi backend'inin adresi (downlink buradan alınır)
# SHIP_URL=http://192.168.1.10:8000
# Dünya üssü girişi: EARTH / EARTH_PASSWORD (büyük/küçük harf duyarsız)
# EARTH_PASSWORD=EARTH
# Token imza anahtarı (boşsa istasyon DB'sinde rastgele üretilir)
# AUTH_SECRET=

# --- Downlink (gemi → Dünya) ---
# İki istasyonda AYNI olmalı; gemide boşsa downlink kapalıdır (Dünya bağlanamaz)
# EARTH_LINK_TOKEN=uzun-rastgele-bir-anahtar
# Olaylar gemide bu kadar bekletilip sonra yayınlanır (gecikme deneyi)
DOWNLINK_DELAY_SECONDS=0
# Gerçek ışık gecikmesi etiketi (dakika); olaylarla taşınır ve gösterilir, bekletmez
DOWNLINK_SIMULATED_LIGHT_DELAY_MINUTES=20
DOWNLINK_HEARTBEAT_SECONDS=5

# --- Terminal varlığı (gemi) ---
# Astronot ekranı (/me) açıkken bu aralıkla gemiye sinyal gönderir (saniye)
PRESENCE_HEARTBEAT_SECONDS=30
# Bu kadar saniye sinyal gelmezse terminal çevrimdışı sayılır; Dünya'ya sadece durum değişimi gider
PRESENCE_TIMEOUT_SECONDS=120
# Gemide zaman aşımı denetiminin aralığı (saniye)
PRESENCE_SWEEP_SECONDS=5

# Virgülle ayrılmış liste. Takım farklı makinelerden bağlanıyorsa IP'leri ekleyin.
# Örn: http://localhost:5173,http://192.168.1.42:5173   (her şeye izin: *)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Veri ---
# astronaut_health: data/raw/astronaut_health.json (yeni ekranlar /me ve /monitor)
# synthetic: eski sentetik veri + eski analiz motoru (sadece /legacy ekranları ve eski API)
DATA_SOURCE=astronaut_health
# DATASET_PATH=data/raw/astronaut_health.json
# DATA_DIR=data
# DATABASE_URL=sqlite:///C:/path/to/ship.db   (varsayılan: data/processed/<STATION_ROLE>.db; synthetic → health.db)

# --- Analiz ---
# Çalışacak olay dedektörleri (sıra önemli: system_pattern en sonda olmalı).
# ML ekibi kendi dedektörünü kaydedip buraya ekler: ...,iforest,system_pattern
ANALYSIS_DETECTORS=threshold,baseline_deviation,trend,system_pattern
# UI geliştirme için örnek changepoint/forecast olayları üretir (gerçek ML değil):
# ANALYSIS_DETECTORS=threshold,baseline_deviation,trend,example_changepoint,example_forecast,system_pattern

# --- Check-in ---
# scripted: prototipteki kural tabanlı akış (varsayılan) | llm: LLM (JSON şemalı) | auto: LLM, olmazsa scripted
CHECKIN_MODE=scripted
# Check-in kartında gösterilen model adı ("Asistan: Qwen"). Boşsa LLM_MODEL'den türetilir (qwen3:14b → Qwen).
ASSISTANT_NAME=

# --- LLM ---
# mock: GPU/model olmadan şablon cevaplar (arayüz geliştirme için)
# openai: OpenAI uyumlu herhangi bir sunucu (Ollama, vLLM, llama.cpp server)
LLM_PROVIDER=mock
# İki makine senaryosu: LLM_BASE_URL=http://<arkadas-ip>:11434/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:14b
LLM_API_KEY=ollama
# Saniye. 14B model + CPU offload yavaş olabilir; ağ üzerinden bağlanırken cömert tutun.
LLM_TIMEOUT=180
LLM_HEALTH_TIMEOUT=3
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
# Qwen3 thinking modu (varsayılan kapalı = hızlı). Açıkken düşünce metni `thinking` SSE olayıyla gelir.
LLM_THINKING=false
# Qwen3 için /think ve /no_think soft switch'ini sistem prompt'una ekle (Qwen dışı modelde false yapın)
LLM_QWEN_SOFT_SWITCH=true
# native: sunucunun tool calling'i | prompt: prompt tabanlı JSON | auto: native dene, olmazsa prompt
LLM_TOOL_MODE=auto
LLM_MAX_TOOL_STEPS=5
# Sunucuya özel ek parametreler (JSON). Örn. vLLM: {"chat_template_kwargs": {"enable_thinking": false}}
LLM_EXTRA_BODY={}
MOCK_STREAM_DELAY_MS=15

# --- Asistan katmanı (isteğe bağlı; sadece "Asistana sor") ---
# LLM ekibinin API'si: kural motoru + [D]/[K] kaynak rozetleri. Doluysa /me sohbeti önce buraya gider;
# ulaşılamazsa yukarıdaki LLM_* (Ollama) yoluna düşer. Check-in her zaman LLM_* yolunu kullanır.
# ASSISTANT_LAYER_URL=http://192.168.1.12:8000/v1
ASSISTANT_LAYER_MODEL=ai-gambit-health
ASSISTANT_LAYER_TIMEOUT=180

# --- RAG ---
# keyword: bağımlılıksız BM25 arama | embedding: Embedder + vektör indeksi (LLM ekibi, .[rag] gerekir)
RAG_BACKEND=keyword
# sentence_transformers (bu makinede CPU) | ollama (arkadaşın makinesindeki Ollama embedding modeli)
EMBEDDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_BASE_URL=http://<arkadas-ip>:11434/v1
# DOCS_DIR=data/docs
RAG_TOP_K=4
