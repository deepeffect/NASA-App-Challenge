# Kopyala: cp .env.example .env   (PowerShell: Copy-Item .env.example .env)
# Göreli yollar repo köküne göre çözülür.

APP_ENV=dev

# --- İstasyon (README → "3 bilgisayar kurulumu") ---
# ship: gemi bilgisayarı (bütün veri, astronot ekranı /me) | earth: Dünya üssü (salt okunur, /monitor)
STATION_ROLE=ship
# Sadece earth: gemi backend'inin adresi (downlink buradan alınır)
# SHIP_URL=http://192.168.1.10:8000

# Virgülle ayrılmış liste. Takım farklı makinelerden bağlanıyorsa IP'leri ekleyin.
# Örn: http://localhost:5173,http://192.168.1.42:5173   (her şeye izin: *)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Veri ---
# DATA_DIR=data
# DATABASE_URL=sqlite:///C:/path/to/ship.db   (varsayılan: data/processed/<STATION_ROLE>.db)

# --- Analiz ---
# Çalışacak olay dedektörleri (sıra önemli: system_pattern en sonda olmalı).
# ML ekibi kendi dedektörünü kaydedip buraya ekler: ...,iforest,system_pattern
ANALYSIS_DETECTORS=threshold,baseline_deviation,trend,system_pattern
# UI geliştirme için örnek changepoint/forecast olayları üretir (gerçek ML değil):
# ANALYSIS_DETECTORS=threshold,baseline_deviation,trend,example_changepoint,example_forecast,system_pattern

# --- LLM ---
# mock: GPU/model olmadan şablon cevaplar (arayüz geliştirme için)
# openai: OpenAI uyumlu herhangi bir sunucu (Ollama, vLLM, llama.cpp server)
LLM_PROVIDER=mock
# İki makine senaryosu: LLM_BASE_URL=http://<arkadas-ip>:11434/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:14b
LLM_API_KEY=ollama
# Saniye. 14B model + CPU offload yavaş olabilir; ağ üzerinden bağlanırken cömert tutun.
LLM_TIMEOUT=120
LLM_HEALTH_TIMEOUT=3
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
# Qwen3 thinking modu (varsayılan kapalı = hızlı). Açıkken düşünce metni `thinking` SSE olayıyla gelir.
LLM_THINKING=false
# Qwen3 için /think ve /no_think soft switch'ini sistem prompt'una ekle (Qwen dışı modelde false yapın)
LLM_QWEN_SOFT_SWITCH=true
# native: sunucunun tool calling'i | prompt: prompt tabanlı JSON | auto: native dene, olmazsa prompt
LLM_TOOL_MODE=auto
LLM_MAX_TOOL_STEPS=5
# Sunucuya özel ek parametreler (JSON). Örn. vLLM: {"chat_template_kwargs": {"enable_thinking": false}}
LLM_EXTRA_BODY={}
MOCK_STREAM_DELAY_MS=15

# --- RAG ---
# keyword: bağımlılıksız BM25 arama | embedding: Embedder + vektör indeksi (LLM ekibi, .[rag] gerekir)
RAG_BACKEND=keyword
# sentence_transformers (bu makinede CPU) | ollama (arkadaşın makinesindeki Ollama embedding modeli)
EMBEDDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_BASE_URL=http://<arkadas-ip>:11434/v1
# DOCS_DIR=data/docs
RAG_TOP_K=4
