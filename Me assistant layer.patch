+    const key = /^\[([DK]\d+)\]$/.exec(part)?.[1];
+    const src = key ? sources[key] : undefined;
+    if (!key || !src) return part;
+    return (
+      <span key={i} className="src" title={sourceTitle(src)} data-source={key}>
+        {SOURCE_ICON[src.type]} {key}
+      </span>
+    );
+  });
