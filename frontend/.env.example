# Backend adresi (sonunda / olmadan). Ağdaki başka makineden bağlanıyorsanız IP yazın
# ve backend .env'deki CORS_ORIGINS'e bu frontend'in adresini ekleyin.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Asistan API'si (sohbet, uyarı açıklamaları, günlük rapor). LLM arkadaşın Mac'inde bu API'nin arkasında.
VITE_ASSISTANT_API_URL=http://192.168.1.12:8000
# Boş bırakılırsa asistan API'sinde yüklü astronot (örn. A1) kullanılır.
# VITE_ASSISTANT_ASTRONAUT_ID=
